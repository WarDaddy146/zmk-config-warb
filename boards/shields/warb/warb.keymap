#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q     &kp W    &kp E     &kp R     &kp T
                &kp A     &kp S    &kp D     &kp F     &kp G
                &kp LSHFT &kp Z    &kp X     &kp C     &kp V
                &kp LCTRL &kp LALT &kp SPACE &kp ENTER &kp BSPC
            >;
        };
    };
};